  */
 void sandbox_sf_set_block_protect(struct udevice *dev, int bp_mask);
 
+/**
+ * sandbox_sf_set_read_id_error() - Inject an RDID transfer failure
+ * @dev: Emulated SPI flash
+ * @error: Negative errno, or zero to restore normal responses
+ */
+void sandbox_sf_set_read_id_error(struct udevice *dev, int error);
+
+/**
+ * sandbox_sf_get_read_id_count() - Count RDID commands sent to an emulator
+ * @dev: Emulated SPI flash
+ * Return: Number of RDID commands, including failed transfers
+ */
+unsigned int sandbox_sf_get_read_id_count(struct udevice *dev);
+
 /**
  * sandbox_get_codec_params() - Read back codec parameters
  *
diff --git a/cmd/sf.c b/cmd/sf.c
index e93c082692e9..9a9755ba2b27 100644
--- a/cmd/sf.c
+++ b/cmd/sf.c
@@ -94,12 +94,24 @@ static int do_spi_flash_probe(int argc, char *const argv[])
 	char *endp;
 	bool use_dt = true;
 #if CONFIG_IS_ENABLED(DM_SPI_FLASH)
+	bool trust_compat = false;
 	struct udevice *new, *bus_dev;
+	struct spi_flash_plat *probe_plat = NULL;
 	int ret;
 #else
