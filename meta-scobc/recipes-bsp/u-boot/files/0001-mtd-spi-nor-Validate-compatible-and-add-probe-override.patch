+		return CMD_RET_USAGE;
+
 	if (argc >= 2) {
 		cs = simple_strtoul(argv[1], &endp, 0);
 		if (*argv[1] == 0 || (*endp != 0 && *endp != ':'))
@@ -129,19 +141,34 @@ static int do_spi_flash_probe(int argc, char *const argv[])
 	}
 
 #if CONFIG_IS_ENABLED(DM_SPI_FLASH)
+	flash = NULL;
 	/* Remove the old device, otherwise probe will just be a nop */
 	ret = spi_find_bus_and_cs(bus, cs, &bus_dev, &new);
+	if (trust_compat &&
+	    (ret || device_get_uclass_id(new) != UCLASS_SPI_FLASH ||
+	     new->driver->probe != spi_flash_std_probe)) {
+		puts("--trust-compat requires a bound standard SPI NOR device\n");
+		return CMD_RET_FAILURE;
+	}
 	if (!ret) {
-		device_remove(new, DM_REMOVE_NORMAL);
+		ret = device_remove(new, DM_REMOVE_NORMAL);
+		if (ret)
+			return CMD_RET_FAILURE;
 	}
-	flash = NULL;
-	if (use_dt) {
+	if (trust_compat) {
+		probe_plat = dev_get_uclass_plat(new);
+		probe_plat->trust_compat = true;
+	}
+	if (use_dt)
 		ret = spi_flash_probe_bus_cs(bus, cs, &new);
-		if (!ret)
-			flash = dev_get_uclass_priv(new);
-	} else {
-		flash = spi_flash_probe(bus, cs, speed, mode);
-	}
+	else
+		ret = spi_flash_probe_bus_cs_speed_mode(bus, cs, speed, mode, &new);
+	if (!ret)
+		flash = dev_get_uclass_priv(new);
+
+	/* The override belongs to this invocation, even if probing failed. */
+	if (probe_plat)
+		probe_plat->trust_compat = false;
 
 	if (!flash) {
 		printf("Failed to initialize SPI flash at %u:%u (error %d)\n",
@@ -650,8 +677,13 @@ static int do_spi_flash(struct cmd_tbl *cmdtp, int flag, int argc,
 }
 
 U_BOOT_LONGHELP(sf,
-	"probe [[bus:]cs] [hz] [mode]	- init flash device on given SPI bus\n"
-	"				  and chip select\n"
+#if CONFIG_IS_ENABLED(SPI_FLASH_VALIDATE_COMPAT)
+	"probe [--trust-compat] [[bus:]cs] [hz] [mode]\n"
+	"\t- init flash; --trust-compat skips initial RDID validation\n"
+#else
+	"probe [[bus:]cs] [hz] [mode]\t- init flash device on given SPI bus\n"
+	"\t\t\t\t  and chip select\n"
+#endif
 	"sf read addr offset|partition len	- read `len' bytes starting at\n"
 	"				          `offset' or from start of mtd\n"
 	"					  `partition'to memory at `addr'\n"
@@ -676,6 +708,6 @@ U_BOOT_LONGHELP(sf,
 	);
 
 U_BOOT_CMD(
-	sf,	5,	1,	do_spi_flash,
+	sf,	5 + CONFIG_IS_ENABLED(SPI_FLASH_VALIDATE_COMPAT),	1,	do_spi_flash,
 	"SPI flash sub-system", sf_help_text
 );
diff --git a/drivers/mtd/spi/Kconfig b/drivers/mtd/spi/Kconfig
index d58a64fc08c7..afe469fa6151 100644
--- a/drivers/mtd/spi/Kconfig
+++ b/drivers/mtd/spi/Kconfig
@@ -89,6 +89,21 @@ config BOOTDEV_SPI_FLASH
 
 	  If unsure, say N
 
+config SPI_FLASH_VALIDATE_COMPAT
+	bool "Validate SPI NOR device-tree compatible against JEDEC ID"
+	depends on DM_SPI_FLASH && OF_CONTROL
+	help
+	  Require the initial RDID response to match a known, specific
+	  device-tree compatible. Reject unknown named parts and ID mismatches
+	  instead of selecting another part. Missing or generic jedec,spi-nor
+	  compatibles retain automatic detection.
+
+	  This also enables sf probe --trust-compat to use the named part
+	  without initial RDID validation when recovering from an unreliable
+	  ID response. The override applies only to that probe invocation.
+
+	  If unsure, say N.
+
 config SPI_FLASH_SFDP_SUPPORT
 	bool "SFDP table parsing support for SPI NOR flashes"
 	depends on !SPI_FLASH_BAR
diff --git a/drivers/mtd/spi/sandbox.c b/drivers/mtd/spi/sandbox.c
index e5ebc3479fb1..c353ea6fe6f9 100644
--- a/drivers/mtd/spi/sandbox.c
+++ b/drivers/mtd/spi/sandbox.c
@@ -93,6 +93,8 @@ struct sandbox_spi_flash {
 	const struct flash_info *data;
 	/* The file on disk to serv up data from */
 	int fd;
+	int read_id_error;
+	unsigned int read_id_count;
 };
 
 struct sandbox_spi_flash_plat_data {
@@ -110,6 +112,20 @@ void sandbox_sf_set_block_protect(struct udevice *dev, int bp_mask)
 	sbsf->status |= bp_mask << STAT_BP_SHIFT;
 }
 
+void sandbox_sf_set_read_id_error(struct udevice *dev, int error)
+{
+	struct sandbox_spi_flash *sbsf = dev_get_priv(dev);
+
+	sbsf->read_id_error = error;
+}
+
+unsigned int sandbox_sf_get_read_id_count(struct udevice *dev)
+{
+	struct sandbox_spi_flash *sbsf = dev_get_priv(dev);
+
+	return sbsf->read_id_count;
+}
+
 /**
  * This is a very strange probe function. If it has platform data (which may
  * have come from the device tree) then this function gets the filename and
@@ -242,6 +258,9 @@ static int sandbox_sf_process_cmd(struct sandbox_spi_flash *sbsf, const u8 *rx,
 	sbsf->cmd = rx[0];
 	switch (sbsf->cmd) {
 	case SPINOR_OP_RDID:
+		sbsf->read_id_count++;
+		if (sbsf->read_id_error)
+			return sbsf->read_id_error;
 		sbsf->state = SF_ID;
 		sbsf->cmd = SF_ID;
 		break;
