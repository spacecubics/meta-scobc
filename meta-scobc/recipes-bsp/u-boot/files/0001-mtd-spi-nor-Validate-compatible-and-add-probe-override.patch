+{
+	struct udevice *dev;
+
+	if (spi_flash_probe_bus_cs_speed_mode(busnum, cs, max_hz, spi_mode, &dev))
 		return NULL;
 
-	return dev_get_uclass_priv(slave->dev);
+	return dev_get_uclass_priv(dev);
 }
 
