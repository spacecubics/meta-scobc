+/* Invalid properties must not be treated like an absent compatible. */
+static int dm_test_spi_flash_invalid_compat(struct unit_test_state *uts)
+{
+	static const char compat[] = "spansion,m25p16\0jedec,spi-nor";
+	static const char malformed[] = "spansion,m25p32";
+	struct udevice *dev, *emul;
+	struct spi_flash_plat *plat;
+	ofnode node;
+	unsigned int count;
+
+	ut_assertok(os_write_file("spi.bin", map_sysmem(0x20000, 0x200000),
+				  0x200000));
+	ut_assertok(run_command("sf probe 0:0", 0));
+	ut_assertok(uclass_first_device_err(UCLASS_SPI_FLASH, &dev));
+	ut_assertok(uclass_first_device_err(UCLASS_SPI_EMUL, &emul));
+	node = dev_ofnode(dev);
+	plat = dev_get_uclass_plat(dev);
+	count = sandbox_sf_get_read_id_count(emul);
+
+	/* A named part without a terminating NUL is not a valid string. */
+	ut_assertok(ofnode_write_prop(node, "compatible", malformed,
+				     sizeof(malformed) - 1, true));
+	ut_assert(run_command("sf probe 0:0", 0));
+	ut_assert(run_command("sf probe --trust-compat 0:0", 0));
+	ut_assert(!plat->trust_compat);
+	ut_asserteq(count, sandbox_sf_get_read_id_count(emul));
+	ut_assert(run_command("sf read 1000 0 1", 0));
+
+	/* Empty properties and empty strings are invalid too. */
+	ut_assertok(ofnode_write_prop(node, "compatible", NULL, 0, false));
+	ut_assert(run_command("sf probe 0:0", 0));
+	ut_assert(run_command("sf probe --trust-compat 0:0", 0));
+	ut_assert(!plat->trust_compat);
+	ut_asserteq(count, sandbox_sf_get_read_id_count(emul));
+	ut_assertok(ofnode_write_string(node, "compatible", ""));
+	ut_assert(run_command("sf probe 0:0", 0));
+	ut_assert(run_command("sf probe --trust-compat 0:0", 0));
+	ut_assert(!plat->trust_compat);
+	ut_asserteq(count, sandbox_sf_get_read_id_count(emul));
+
+	/* Only a missing property retains automatic detection. */
+	ut_assertok(ofnode_delete_prop(node, "compatible"));
+	ut_assertok(run_command("sf probe 0:0", 0));
+	ut_asserteq(count + 1, sandbox_sf_get_read_id_count(emul));
+	ut_assert(run_command("sf probe --trust-compat 0:0", 0));
+	ut_assert(!plat->trust_compat);
+	ut_asserteq(count + 1, sandbox_sf_get_read_id_count(emul));
+
+	ut_assertok(ofnode_write_prop(node, "compatible", compat, sizeof(compat),
+				     true));
+	sandbox_sf_unbind_emul(state_get_current(), 0, 0);
+
+	return 0;
+}
+DM_TEST(dm_test_spi_flash_invalid_compat, UTF_SCAN_FDT);
