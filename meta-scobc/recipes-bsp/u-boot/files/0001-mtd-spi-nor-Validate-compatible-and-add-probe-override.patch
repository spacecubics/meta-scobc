+
+DECLARE_GLOBAL_DATA_PTR;
 
 /* Simple test of sandbox SPI flash */
 static int dm_test_spi_flash(struct unit_test_state *uts)
@@ -74,6 +81,338 @@ static int dm_test_spi_flash(struct unit_test_state *uts)
 }
 DM_TEST(dm_test_spi_flash, UTF_SCAN_PDATA | UTF_SCAN_FDT);
 
+#if CONFIG_IS_ENABLED(SPI_FLASH_VALIDATE_COMPAT)
+/* A force request must neither read RDID nor survive this command. */
+static int dm_test_spi_flash_trust_compat(struct unit_test_state *uts)
+{
+	static const char compat[] = "spansion,m25p16\0jedec,spi-nor";
+	struct udevice *dev, *emul;
+	struct spi_flash_plat *plat;
+	struct spi_flash *nor;
+	ofnode node;
+	unsigned int count;
+	int ret;
+#if CONFIG_IS_ENABLED(LOG)
+	int log_fmt;
+#endif
+	u8 byte;
+
+	ut_assertok(os_write_file("spi.bin", map_sysmem(0x20000, 0x200000),
+				  0x200000));
+	ut_assertok(console_record_reset_enable());
+	ut_assertok(run_command("sf probe --trust-compat 0:0", 0));
+	ut_assert_skip_to_line("SF: WARNING: trusting compatible for %s; JEDEC ID NOT verified",
+			       "m25p16");
+	ut_assertok(uclass_first_device_err(UCLASS_SPI_FLASH, &dev));
+	/* A trusted legacy part needs no bus traffic during initialization. */
+	ut_assertok(spi_flash_read_dm(dev, 0, 1, &byte));
+	ut_assertok(uclass_first_device_err(UCLASS_SPI_EMUL, &emul));
+	ut_asserteq(0, sandbox_sf_get_read_id_count(emul));
+	ut_assertok(run_command("sf probe 0:0", 0));
+	node = dev_ofnode(dev);
+	plat = dev_get_uclass_plat(dev);
+	count = sandbox_sf_get_read_id_count(emul);
+
+	/* The emulator remains an m25p16 while DT expects an m25p32. */
+	ut_assertok(ofnode_write_string(node, "compatible", "spansion,m25p32"));
+	ut_assertok(console_record_reset_enable());
+#if CONFIG_IS_ENABLED(LOG)
+	log_fmt = gd->log_fmt;
+	gd->log_fmt = BIT(LOGF_MSG);
+#endif
+	ret = run_command("sf probe 0:0", 0);
+#if CONFIG_IS_ENABLED(LOG)
+	gd->log_fmt = log_fmt;
+#endif
+	ut_assert(ret);
+	ut_assert_skip_to_line("%s %s: JEDEC ID mismatch for m25p32: got 202015, expected 202016",
+			       dev->driver->name, dev->name);
+	ut_asserteq(count + 1, sandbox_sf_get_read_id_count(emul));
+	count++;
+	ut_assertok(console_record_reset_enable());
+	ut_assertok(run_command("sf probe --trust-compat 0:0", 0));
+	ut_assert_skip_to_line("SF: WARNING: trusting compatible for %s; JEDEC ID NOT verified",
+			       "m25p32");
+	ut_asserteq(count, sandbox_sf_get_read_id_count(emul));
+	ut_assert(!plat->trust_compat);
+	nor = dev_get_uclass_priv(dev);
+	ut_asserteq(0x400000, nor->mtd.size);
+	ut_assert(run_command("sf probe 0:0", 0));
+	ut_assert(!plat->trust_compat);
+	ut_assert(run_command("sf read 1000 0 1", 0));
+
+	/* A failed RDID can be bypassed even with explicit speed and mode. */
+	sandbox_sf_set_read_id_error(emul, -EIO);
+	count = sandbox_sf_get_read_id_count(emul);
+	ut_assertok(run_command("sf probe --trust-compat 0:0 1000000 0", 0));
+	ut_asserteq(count, sandbox_sf_get_read_id_count(emul));
+	ut_assert(!plat->trust_compat);
+	ut_assertok(console_record_reset_enable());
+	ut_assert(run_command("sf probe 0:0", 0));
+	ut_assert_skip_to_line("Failed to initialize SPI flash at 0:0 (error -5)");
+	ut_assert(!plat->trust_compat);
+	ut_assertok(console_record_reset_enable());
+	ut_assert(run_command("sf probe 0:0 1000000 0", 0));
+	ut_assert_skip_to_line("Failed to initialize SPI flash at 0:0 (error -5)");
+	ut_assert(!plat->trust_compat);
+	sandbox_sf_set_read_id_error(emul, 0);
+
+	/* Unknown and generic compatibles cannot be forced. */
+	count = sandbox_sf_get_read_id_count(emul);
+	ut_assertok(ofnode_write_string(node, "compatible", "vendor,unknown"));
+	ut_assert(run_command("sf probe --trust-compat 0:0", 0));
+	ut_assert(!plat->trust_compat);
+	ut_assert(run_command("sf probe 0:0", 0));
+	ut_asserteq(count, sandbox_sf_get_read_id_count(emul));
+	ut_assertok(ofnode_write_string(node, "compatible", "jedec,spi-nor"));
+	ut_assert(run_command("sf probe --trust-compat 0:0", 0));
+	ut_assert(!plat->trust_compat);
+	ut_asserteq(count, sandbox_sf_get_read_id_count(emul));
+	ut_assertok(run_command("sf probe 0:0", 0));
+	ut_asserteq(count + 1, sandbox_sf_get_read_id_count(emul));
+
+	/* A bad target must not leave the previously selected flash usable. */
+	ut_assert(run_command("sf probe --trust-compat 999:0", 0));
+	ut_assert(run_command("sf read 1000 0 1", 0));
+
+	ut_assertok(ofnode_write_prop(node, "compatible", compat, sizeof(compat),
+				     true));
+	sandbox_sf_unbind_emul(state_get_current(), 0, 0);
+
+	return 0;
+}
+DM_TEST(dm_test_spi_flash_trust_compat, UTF_SCAN_FDT | UTF_LIVE_TREE);
