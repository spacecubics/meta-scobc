diff --git a/drivers/mtd/spi/spi-nor-core.c b/drivers/mtd/spi/spi-nor-core.c
index 5f90f2b1d618..08e10e67d9f9 100644
--- a/drivers/mtd/spi/spi-nor-core.c
+++ b/drivers/mtd/spi/spi-nor-core.c
@@ -10,6 +10,7 @@
  */
 
 #include <display_options.h>
+#include <hexdump.h>
 #include <log.h>
 #include <watchdog.h>
 #include <asm-generic/gpio.h>
@@ -31,6 +32,7 @@
 #include <mtd/cfi_flash.h>
 #include <spi-mem.h>
 #include <spi.h>
+#include <spi_flash.h>
 
 #include "sf_internal.h"
 
@@ -1594,7 +1596,51 @@ static int stm_is_unlocked(struct spi_nor *nor, loff_t ofs, uint64_t len)
 #endif
 #endif
 
-static const struct flash_info *spi_nor_read_id(struct spi_nor *nor)
+static const struct flash_info *spi_nor_match_compat(struct spi_nor *nor)
+{
+#if CONFIG_IS_ENABLED(SPI_FLASH_VALIDATE_COMPAT)
+	const struct flash_info *info;
+	const char *compat, *name;
+
+	if (!dev_has_ofnode(nor->dev) ||
+	    !dev_read_bool(nor->dev, "compatible"))
+		return NULL;
+
+	compat = dev_read_string(nor->dev, "compatible");
+	if (!compat || !*compat) {
+		dev_err(nor->dev, "invalid SPI NOR compatible\n");
+		return ERR_PTR(-EINVAL);
+	}
+	if (!strcmp(compat, "jedec,spi-nor"))
+		return NULL;
+
+	name = strchr(compat, ',');
+	name = name ? name + 1 : compat;
+	for (info = spi_nor_ids; info->name; info++) {
+		if (!strcmp(info->name, name))
+			return info;
+	}
+
+	dev_err(nor->dev, "unknown SPI NOR compatible %s\n", compat);
+	return ERR_PTR(-ENODEV);
+#else
+	return NULL;
+#endif
+}
+
+static bool spi_nor_trust_compat(struct spi_nor *nor)
+{
+#if CONFIG_IS_ENABLED(SPI_FLASH_VALIDATE_COMPAT)
+	struct spi_flash_plat *plat = dev_get_uclass_plat(nor->dev);
+
+	return plat->trust_compat;
+#else
+	return false;
+#endif
+}
+
+static const struct flash_info *spi_nor_read_id(struct spi_nor *nor,
+					      const struct flash_info *expected)
 {
 	int			tmp;
 	u8			id[SPI_NOR_MAX_ID_LEN];
@@ -1609,6 +1655,23 @@ static const struct flash_info *spi_nor_read_id(struct spi_nor *nor)
 		return ERR_PTR(tmp);
 	}
 
+	if (expected) {
+		if (memcmp(expected->id, id, expected->id_len)) {
+			char actual_id[2 * SPI_NOR_MAX_ID_LEN + 1];
+			char expected_id[2 * SPI_NOR_MAX_ID_LEN + 1];
+
+			*bin2hex(actual_id, id, expected->id_len) = '\0';
+			*bin2hex(expected_id, expected->id,
+				 expected->id_len) = '\0';
+			dev_err(nor->dev,
+				"JEDEC ID mismatch for %s: got %s, expected %s\n",
+				expected->name, actual_id, expected_id);
+			return ERR_PTR(-ENODEV);
+		}
+		memcpy(nor->spi->device_id, id, SPI_NOR_MAX_ID_LEN);
+		return expected;
+	}
+
 	info = spi_nor_ids;
 	for (; info->name; info++) {
 		if (info->id_len) {
@@ -6176,7 +6239,8 @@ static bool spansion_flash_lock_info(struct spi_nor *nor)
  *
  * Return: 0 for success, -errno for failure.
  */
-static int spi_nor_soft_reset(struct spi_nor *nor)
+static int spi_nor_soft_reset(struct spi_nor *nor,
+			      const struct flash_info *expected)
 {
 	struct spi_mem_op op;
 	int ret;
@@ -6191,10 +6255,15 @@ static int spi_nor_soft_reset(struct spi_nor *nor)
 #endif /* SPI_NOR_BOOT_SOFT_RESET_EXT_INVERT */
 	}
 
-	ret = nor->read_reg(nor, SPINOR_OP_RDID, id, SPI_NOR_MAX_ID_LEN);
-	if (ret < 0) {
-		dev_dbg(nor->dev, "error %d reading JEDEC ID\n", ret);
-		return ret;
+	if (expected) {
+		/* A named part supplies the reset protocol without an RDID read. */
+		id[0] = JEDEC_MFR(expected);
+	} else {
+		ret = nor->read_reg(nor, SPINOR_OP_RDID, id, SPI_NOR_MAX_ID_LEN);
+		if (ret < 0) {
+			dev_dbg(nor->dev, "error %d reading JEDEC ID\n", ret);
+			return ret;
+		}
 	}
 
 	if (id[0] ==  SNOR_MFR_MACRONIX) {
@@ -6239,9 +6308,10 @@ out:
 int spi_nor_remove(struct spi_nor *nor)
 {
 #ifdef CONFIG_SPI_FLASH_SOFT_RESET
+	/* The active part already identifies the reset command extension. */
 	if (nor->info->flags & SPI_NOR_OCTAL_DTR_READ &&
 	    nor->flags & SNOR_F_SOFT_RESET)
-		return spi_nor_soft_reset(nor);
+		return spi_nor_soft_reset(nor, nor->info);
 #endif
 
 	return 0;
@@ -6392,11 +6462,25 @@ int spi_nor_scan(struct spi_nor *nor)
 {
 	struct spi_nor_flash_parameter params;
 	const struct flash_info *info = NULL;
+	const struct flash_info *expected;
 	struct mtd_info *mtd = &nor->mtd;
 	struct spi_slave *spi = nor->spi;
 	int ret;
 	int cfi_mtd_nb = 0;
 	bool shift = 0;
+	bool trust_compat = spi_nor_trust_compat(nor);
+
+	expected = spi_nor_match_compat(nor);
+	if (IS_ERR(expected))
+		return PTR_ERR(expected);
+	if (trust_compat && !expected) {
+		dev_err(nor->dev, "--trust-compat requires a known specific compatible\n");
+		return -EINVAL;
+	}
+	if (expected && !expected->id_len && !trust_compat) {
+		dev_err(nor->dev, "cannot validate JEDEC ID for %s\n", expected->name);
+		return -ENODEV;
+	}
 
 #ifdef CONFIG_FLASH_CFI_MTD
 	cfi_mtd_nb = CFI_FLASH_BANKS;
@@ -6443,12 +6527,21 @@ int spi_nor_scan(struct spi_nor *nor)
 	 * and only one of them needs a soft reset, failure to reset is not
 	 * made fatal, and we still try to read ID if possible.
 	 */
-	spi_nor_soft_reset(nor);
+	spi_nor_soft_reset(nor, expected);
 #endif /* CONFIG_SPI_FLASH_SOFT_RESET_ON_BOOT */
 
-	info = spi_nor_read_id(nor);
-	if (IS_ERR_OR_NULL(info))
-		return -ENOENT;
+	if (trust_compat) {
+		printf("SF: WARNING: trusting compatible for %s; JEDEC ID NOT verified\n",
+		       expected->name);
+		memset(nor->spi->device_id, 0, SPI_NOR_MAX_ID_LEN);
+		memcpy(nor->spi->device_id, expected->id, expected->id_len);
+		info = expected;
+	} else {
+		info = spi_nor_read_id(nor, expected);
+		if (IS_ERR(info))
+			return CONFIG_IS_ENABLED(SPI_FLASH_VALIDATE_COMPAT) ?
+				PTR_ERR(info) : -ENOENT;
+	}
 	nor->info = info;
 
 	spi_nor_set_fixups(nor);
diff --git a/include/spi_flash.h b/include/spi_flash.h
index 9086e6601c13..6c843c1a9e9e 100644
--- a/include/spi_flash.h
+++ b/include/spi_flash.h
@@ -101,9 +101,32 @@ int spl_flash_get_sw_write_prot(struct udevice *dev);
  */
 int spi_flash_std_probe(struct udevice *dev);
 
+/**
+ * struct spi_flash_plat - Per-device SPI flash probe options
+ * @trust_compat: Skip initial RDID validation for a known compatible; the
+ * caller must clear this request after the probe, including on failure.
+ */
+struct spi_flash_plat {
+	bool trust_compat;
+};
+
 int spi_flash_probe_bus_cs(unsigned int busnum, unsigned int cs,
 			   struct udevice **devp);
 
+/**
+ * spi_flash_probe_bus_cs_speed_mode() - Probe with an explicit speed and mode
+ * @busnum: SPI bus number
+ * @cs: Chip select number
+ * @max_hz: Maximum clock frequency in Hz
+ * @spi_mode: SPI mode flags
+ * @devp: Returns the probed flash device on success
+ *
+ * Return: 0 on success, or the original negative probe/setup error
+ */
+int spi_flash_probe_bus_cs_speed_mode(unsigned int busnum, unsigned int cs,
+				      unsigned int max_hz, unsigned int spi_mode,
+				      struct udevice **devp);
+
 /* Compatibility function - this is the old U-Boot API */
 struct spi_flash *spi_flash_probe(unsigned int bus, unsigned int cs,
 				  unsigned int max_hz, unsigned int spi_mode);
