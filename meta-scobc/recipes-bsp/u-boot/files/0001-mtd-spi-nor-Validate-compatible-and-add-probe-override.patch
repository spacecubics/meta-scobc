+#if CONFIG_IS_ENABLED(SPI_FLASH_SOFT_RESET)
+static unsigned int sf_reset_count;
+static int sf_reset_error;
+
+static bool sf_test_supports_op(struct spi_slave *slave,
+			       const struct spi_mem_op *op)
+{
+	if (op->cmd.dtr && (op->cmd.opcode & 0xff) == SPINOR_OP_SRSTEN)
+		return true;
+	if (op->cmd.dtr && (op->cmd.opcode & 0xff) == SPINOR_OP_SRST)
+		return true;
+
+	return spi_mem_default_supports_op(slave, op);
+}
+
+static int sf_test_exec_op(struct spi_slave *slave, const struct spi_mem_op *op)
+{
+	/* spi-mem uses ENOTSUPP to fall back to ordinary sandbox transfers. */
+	if (!op->cmd.dtr)
+		return -ENOTSUPP;
+
+	sf_reset_count++;
+	return sf_reset_error;
+}
+
+/* Removing an active Octal part must not read RDID before a forced probe. */
+static int dm_test_spi_flash_trust_compat_remove(struct unit_test_state *uts)
+{
+	static const struct spi_controller_mem_ops mem_ops = {
+		.supports_op = sf_test_supports_op,
+		.exec_op = sf_test_exec_op,
+	};
+	struct udevice *dev, *emul, *bus;
+	const struct driver *orig_driver;
+	const struct flash_info *orig_info;
+	struct spi_flash_plat *plat;
+	struct flash_info octal_info;
+	struct spi_flash *nor;
+	struct dm_spi_ops ops;
+	struct driver driver;
+	unsigned int count, orig_flags;
+	int ret;
+
+	ut_assertok(os_write_file("spi.bin", map_sysmem(0x20000, 0x200000),
+				  0x200000));
+	ut_assertok(run_command("sf probe 0:0", 0));
+	ut_assertok(uclass_first_device_err(UCLASS_SPI_FLASH, &dev));
+	ut_assertok(uclass_first_device_err(UCLASS_SPI_EMUL, &emul));
+	plat = dev_get_uclass_plat(dev);
+	bus = dev->parent;
+	orig_driver = bus->driver;
+	driver = *orig_driver;
+	ops = *spi_get_ops(bus);
+	ops.mem_ops = &mem_ops;
+	driver.ops = &ops;
+	sandbox_sf_set_read_id_error(emul, -EIO);
+	count = sandbox_sf_get_read_id_count(emul);
+
+	/* Emulate the reset protocol of an already active Octal DTR part. */
+	nor = dev_get_uclass_priv(dev);
+	orig_info = nor->info;
+	orig_flags = nor->flags;
+	octal_info = *orig_info;
+	octal_info.flags |= SPI_NOR_OCTAL_DTR_READ;
+	nor->info = &octal_info;
+	nor->flags |= SNOR_F_SOFT_RESET;
+	sf_reset_count = 0;
+	sf_reset_error = 0;
+	bus->driver = &driver;
+	ret = run_command("sf probe --trust-compat 0:0", 0);
+	bus->driver = orig_driver;
+	if (ret && device_active(dev)) {
+		nor = dev_get_uclass_priv(dev);
+		nor->info = orig_info;
+		nor->flags = orig_flags;
+	}
+	ut_assertok(ret);
+	ut_asserteq(2, sf_reset_count);
+	ut_asserteq(count, sandbox_sf_get_read_id_count(emul));
+	ut_assert(!plat->trust_compat);
+
+	/* A failed reset must still abort removal and the subsequent probe. */
+	nor = dev_get_uclass_priv(dev);
+	orig_info = nor->info;
+	orig_flags = nor->flags;
+	nor->info = &octal_info;
+	nor->flags |= SNOR_F_SOFT_RESET;
+	sf_reset_count = 0;
+	sf_reset_error = -ETIMEDOUT;
+	bus->driver = &driver;
+	ret = run_command("sf probe --trust-compat 0:0", 0);
+	bus->driver = orig_driver;
+	if (ret && device_active(dev)) {
+		nor = dev_get_uclass_priv(dev);
+		nor->info = orig_info;
+		nor->flags = orig_flags;
+	}
+	ut_assert(ret);
+	ut_asserteq(1, sf_reset_count);
+	ut_asserteq(count, sandbox_sf_get_read_id_count(emul));
+	ut_assert(!plat->trust_compat);
+	ut_assert(run_command("sf read 1000 0 1", 0));
+
+	/* Failed removal must leave direct mappings valid for a later retry. */
+	nor = dev_get_uclass_priv(dev);
+	nor->info = &octal_info;
+	nor->flags |= SNOR_F_SOFT_RESET;
+	sf_reset_count = 0;
+	sf_reset_error = 0;
+	bus->driver = &driver;
+	ret = run_command("sf probe --trust-compat 0:0", 0);
+	bus->driver = orig_driver;
+	if (ret && device_active(dev)) {
+		nor = dev_get_uclass_priv(dev);
+		nor->info = orig_info;
+		nor->flags = orig_flags;
+	}
+	ut_assertok(ret);
+	ut_asserteq(2, sf_reset_count);
+	ut_asserteq(count, sandbox_sf_get_read_id_count(emul));
+	ut_assert(!plat->trust_compat);
+	sandbox_sf_set_read_id_error(emul, 0);
+	sandbox_sf_unbind_emul(state_get_current(), 0, 0);
+
+	return 0;
+}
+DM_TEST(dm_test_spi_flash_trust_compat_remove, UTF_SCAN_FDT | UTF_LIVE_TREE);
+#endif
